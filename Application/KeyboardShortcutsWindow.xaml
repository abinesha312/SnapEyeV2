<Window x:Class="SnapEye.KeyboardShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts"
        Icon="pack://application:,,,/SnapEye;component/Public/Logo/01_Logo_v1.png"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="420"
        Background="#FAFAFA">
    <Border Padding="20" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="12" Margin="12">
        <StackPanel>
            <TextBlock Text="Keyboard shortcuts" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="These work from anywhere on Windows (global) unless noted."
                       FontSize="12" Foreground="#666666" Margin="0,6,0,14" TextWrapping="Wrap"/>

            <ItemsControl x:Name="ShortcutsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF" BorderBrush="#C5DFF8" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="13" Foreground="#333333"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#777777"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#E8F4FF" CornerRadius="6" Padding="8,4" Margin="12,0,0,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Keys}" FontFamily="Consolas,Segoe UI" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#355A8C"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="PrivacyNote" TextWrapping="Wrap" FontSize="11" Foreground="#888888" Margin="0,8,0,16"
                       LineHeight="16"/>

            <Button Content="Close" HorizontalAlignment="Right" Padding="20,8" Click="Close_Click"
                    Background="#3A7BFF" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
