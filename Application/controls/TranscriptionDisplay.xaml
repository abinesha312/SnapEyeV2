<UserControl x:Class="SnapEye.Controls.TranscriptionDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                          Text="Live Transcription"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="White"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Status Indicator -->
                    <Ellipse Width="12" Height="12" 
                            Fill="{Binding StatusColor}"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding StatusText}"
                              Foreground="White"
                              VerticalAlignment="Center"
                              FontSize="14"
                              Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transcription Content -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     Padding="10">
            <StackPanel>
                <!-- Interim Transcript (Real-time) -->
                <Border Background="#FFF9E6" 
                       BorderBrush="#FFD700"
                       BorderThickness="1"
                       CornerRadius="5"
                       Padding="15"
                       Margin="5"
                       Visibility="{Binding InterimTextVisibility}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                  Text="Speaking..."
                                  FontSize="10"
                                  FontWeight="Bold"
                                  Foreground="#FF8C00"
                                  Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="1"
                                  Text="{Binding InterimText}"
                                  FontStyle="Italic"
                                  Foreground="#666666"
                                  TextWrapping="Wrap"
                                  FontSize="14"
                                  MinHeight="20"/>
                    </Grid>
                </Border>

                <!-- Final Transcripts -->
                <ItemsControl ItemsSource="{Binding FinalTranscripts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                   BorderBrush="#E0E0E0"
                                   BorderThickness="1"
                                   CornerRadius="5"
                                   Padding="15"
                                   Margin="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Timestamp and Source -->
                                    <StackPanel Grid.Row="0" 
                                               Orientation="Horizontal" 
                                               Margin="0,0,0,5">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                  FontSize="10"
                                                  Foreground="#999999"
                                                  Margin="0,0,10,0"/>
                                        <Border Background="{Binding SourceColor}"
                                               CornerRadius="3"
                                               Padding="5,2">
                                            <TextBlock Text="{Binding Source}"
                                                      FontSize="10"
                                                      Foreground="White"
                                                      FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Transcript Text -->
                                    <TextBlock Grid.Row="1"
                                              Text="{Binding Text}"
                                              TextWrapping="Wrap"
                                              FontSize="14"
                                              Foreground="#333333"
                                              LineHeight="20"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border Visibility="{Binding EmptyStateVisibility}"
                       Padding="40"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎤"
                                  FontSize="48"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Start speaking to see transcriptions"
                                  FontSize="16"
                                  Foreground="#999999"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" 
               Background="#ECF0F1" 
               Padding="15,10"
               BorderBrush="#BDC3C7"
               BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="{Binding TranscriptCount, StringFormat='Total: {0} transcripts'}"
                          FontSize="12"
                          Foreground="#7F8C8D"
                          VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                       Content="Clear All"
                       Command="{Binding ClearCommand}"
                       Padding="15,5"
                       Background="#E74C3C"
                       Foreground="White"
                       BorderThickness="0"
                       Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

