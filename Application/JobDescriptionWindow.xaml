<Window x:Class="SnapEye.JobDescriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview - Job Description"
        Icon="pack://application:,,,/SnapEye;component/Public/Logo/01_Logo_v1.png"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="520"
        Background="#FAFAFA">
    <Border Padding="22" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="12" Margin="12">
        <StackPanel>
            <TextBlock Text="Interview mode" FontSize="18" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Paste the job description. Every answer will be tailored to this role's skills, tools, and standards - grounded in your saved experience."
                       FontSize="12" Foreground="#666666" Margin="0,6,0,16" TextWrapping="Wrap"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Company" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                    <TextBox x:Name="CompanyBox" FontSize="13" Padding="8,6"
                             BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Role / Title" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                    <TextBox x:Name="RoleBox" FontSize="13" Padding="8,6"
                             BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Job description" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
            <TextBox x:Name="JdBox" FontSize="12" Padding="8,6"
                     BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="180" MaxHeight="320" VerticalScrollBarVisibility="Auto"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Skip" Padding="18,8" Click="Skip_Click"
                        Background="#F2F8FC" Foreground="#6B6478" BorderBrush="#C5DFF8" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Save &amp; tailor" HorizontalAlignment="Right" Padding="22,8" Click="Save_Click"
                        Background="#3A7BFF" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
