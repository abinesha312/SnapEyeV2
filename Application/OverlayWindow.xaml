<Window x:Class="SnapEye.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:solution="clr-namespace:SnapEye.SolutionRegion"
        Title="SnapEye" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="380"
        SizeToContent="Height"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Accent Brush -->
        <SolidColorBrush x:Key="AccentBrush" Color="#6C5CE7"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#A29BFE"/>
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="#16213E"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#0F3460"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#666666"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2D4E"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#00B894"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B"/>
        
        <!-- Icon Button Style (Navbar) -->
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Quick Action Pill Button -->
        <Style x:Key="QuickActionStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6C5CE7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#6C5CE7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Transcript Toggle Style -->
        <Style x:Key="ToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#6C5CE7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- ComboBox Dark Style -->
        <Style x:Key="DarkComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <!-- Scrollbar Style -->
        <Style x:Key="ThinScrollbar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#40FFFFFF"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#6C5CE7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!-- Main Widget Container -->
    <Border CornerRadius="16" 
            Margin="8"
            ClipToBounds="True">
        
        <Border.Background>
            <SolidColorBrush Color="#1A1A2E" Opacity="0.96"/>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#40FFFFFF" Offset="0"/>
                <GradientStop Color="#15FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>
            <Thickness>1</Thickness>
        </Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" 
                              ShadowDepth="4" BlurRadius="20" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Row 0: Navbar -->
                <RowDefinition Height="Auto"/>   <!-- Row 1: Mode bar + Transcript toggle -->
                <RowDefinition Height="*" MinHeight="200" MaxHeight="420"/>  <!-- Row 2: Content -->
                <RowDefinition Height="Auto"/>   <!-- Row 3: Quick actions -->
                <RowDefinition Height="Auto"/>   <!-- Row 4: Chat input -->
            </Grid.RowDefinitions>

            <!-- ============ ROW 0: NAVIGATION BAR ============ -->
            <Border Grid.Row="0" Padding="12,10" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- Drag handle -->
                        <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                        <ColumnDefinition Width="*"/>     <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/>  <!-- Mic toggle -->
                        <ColumnDefinition Width="Auto"/>  <!-- Session timer -->
                        <ColumnDefinition Width="Auto"/>  <!-- Close -->
                    </Grid.ColumnDefinitions>

                    <!-- Drag Handle -->
                    <TextBlock Grid.Column="0" Text="&#x2801;&#x2801;&#x2801;" 
                               FontSize="16" Foreground="#555555" 
                               VerticalAlignment="Center" 
                               Cursor="SizeAll" Margin="0,0,8,0"
                               ToolTip="Drag to reposition"/>

                    <!-- Logo / App Name -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="SnapEye" FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Microphone Toggle -->
                    <Button x:Name="MicToggleBtn" Grid.Column="3" 
                            Style="{StaticResource IconBtnStyle}"
                            Click="MicToggle_Click" Margin="4,0"
                            ToolTip="Toggle listening (Ctrl+Shift+L)">
                        <TextBlock x:Name="MicIcon" Text="&#x1F399;" FontSize="16"/>
                    </Button>

                    <!-- Session Timer / End Button -->
                    <Border x:Name="SessionTimerBorder" Grid.Column="4" 
                            Background="{StaticResource AccentBrush}" 
                            CornerRadius="8" Padding="10,4" Margin="4,0"
                            Cursor="Hand" Visibility="Collapsed"
                            MouseLeftButtonDown="EndSession_Click">
                        <TextBlock x:Name="SessionTimerText" Text="00:00" 
                                   FontSize="12" FontWeight="SemiBold" 
                                   Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Not Listening Indicator (shown when not recording) -->
                    <Border x:Name="NotListeningBadge" Grid.Column="4" 
                            Background="#30FFFFFF" CornerRadius="8" 
                            Padding="8,4" Margin="4,0">
                        <TextBlock Text="Not listening" FontSize="11" 
                                   Foreground="#888888" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Close Button -->
                    <Button x:Name="CloseBtn" Grid.Column="5" 
                            Style="{StaticResource IconBtnStyle}"
                            Click="Close_Click" Margin="4,0,0,0"
                            ToolTip="Hide widget">
                        <TextBlock Text="&#x2715;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ ROW 1: MODE SELECTOR + TRANSCRIPT TOGGLE ============ -->
            <Border Grid.Row="1" Padding="12,8" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mode Selector -->
                    <ComboBox x:Name="ModeSelector" Grid.Column="0" 
                              Style="{StaticResource DarkComboStyle}"
                              SelectionChanged="ModeSelector_Changed"/>

                    <!-- Show Transcript Toggle -->
                    <ToggleButton x:Name="TranscriptToggle" Grid.Column="1" 
                                  Content="Transcript"
                                  Style="{StaticResource ToggleBtnStyle}"
                                  Checked="TranscriptToggle_Changed"
                                  Unchecked="TranscriptToggle_Changed"
                                  Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- ============ ROW 2: MAIN CONTENT (AI Insights / Transcript) ============ -->
            <solution:SolutionRegionAlpha x:Name="AlphaRegion" Grid.Row="2"/>

            <!-- ============ ROW 3: QUICK ACTION BUTTONS ============ -->
            <Border Grid.Row="3" Padding="8,6" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,1,0,0">
                <WrapPanel x:Name="QuickActionsPanel" Orientation="Horizontal">
                    <!-- Populated dynamically from config.yaml -->
                </WrapPanel>
            </Border>

            <!-- ============ ROW 4: CHAT INPUT BAR ============ -->
            <Border Grid.Row="4" Padding="10,8" 
                    Background="#10FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Text Input -->
                    <TextBox x:Name="ChatInput" Grid.Column="0"
                             Background="#15FFFFFF" Foreground="#FFFFFF"
                             BorderBrush="#30FFFFFF" BorderThickness="1"
                             FontSize="12" Padding="10,8"
                             VerticalContentAlignment="Center"
                             Text="" AcceptsReturn="False"
                             KeyDown="ChatInput_KeyDown">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                  Padding="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <!-- Screenshot Button -->
                    <Button x:Name="ScreenshotBtn" Grid.Column="1"
                            Style="{StaticResource IconBtnStyle}"
                            Click="Screenshot_Click" Margin="4,0"
                            ToolTip="Capture screen (Ctrl+Shift+S)">
                        <TextBlock Text="&#x1F4F7;" FontSize="14"/>
                    </Button>

                    <!-- Send Button -->
                    <Button x:Name="SendBtn" Grid.Column="2"
                            Width="34" Height="34"
                            Cursor="Hand" Click="Send_Click"
                            ToolTip="Send (Ctrl+Enter)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="10">
                                    <TextBlock Text="&#x27A4;" FontSize="14" 
                                               Foreground="White"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
