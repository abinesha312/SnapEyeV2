<Window x:Class="SnapEye.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:solution="clr-namespace:SnapEye.SolutionRegion"
        Title="SnapEye" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="680"
        SizeToContent="Height"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- ==================== COLOR PALETTE ==================== -->
        <Color x:Key="PrimaryBgColor">#27272A</Color>
        <Color x:Key="BluePrimaryColor">#2563EB</Color>
        <Color x:Key="BlueHoverColor">#1D4ED8</Color>
        <Color x:Key="BlueActiveColor">#1E40AF</Color>
        <Color x:Key="TextWhiteColor">#F4F4F5</Color>
        <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
        <Color x:Key="TextMutedColor">#71717A</Color>
        <Color x:Key="BorderSubtleColor">#3F3F46</Color>
        <Color x:Key="RedLiveColor">#DC2626</Color>
        
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BluePrimaryColor}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#60A5FA"/>
        <SolidColorBrush x:Key="PrimaryBgBrush" Color="{StaticResource PrimaryBgColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextWhiteColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderSubtleColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>

        <!-- ==================== TOOLBAR ICON BUTTON ==================== -->
        <Style x:Key="ToolbarIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="22" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF"/>
                    <Setter Property="Foreground" Value="#F4F4F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== CLOSE BUTTON (CIRCULAR) ==================== -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== QUICK ACTION PILL ==================== -->
        <Style x:Key="QuickActionStyle" TargetType="Button">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== TOGGLE BUTTON ==================== -->
        <Style x:Key="ToggleBtnStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox: fully templated dark theme (no Windows default white chrome) -->
        <Style x:Key="DarkComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton used by ComboBox chrome (dark) -->
        <Style x:Key="DarkComboToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" Width="10" Height="6" Margin="6,0,8,0"
                                      Stretch="Fill" Fill="#A1A1AA"
                                      Data="M0,0 L10,0 L5,6 Z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#3A3A40"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBg" Background="{TemplateBinding Background}"
                                    BorderBrush="#52525B" BorderThickness="1" CornerRadius="6"/>
                            <ToggleButton x:Name="ToggleBtn" Style="{StaticResource DarkComboToggleStyle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextBlock.Foreground="#F4F4F5"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden"
                                     Background="Transparent" Foreground="#F4F4F5" BorderThickness="0"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#2A2A2E" BorderBrush="#52525B" BorderThickness="1"
                                        CornerRadius="8" Padding="4"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== THIN SCROLLBAR ==================== -->
        <Style x:Key="ThinScrollbar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#20FFFFFF"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EndSessionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="BorderBrush" Value="#7F1D1D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9999" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F1515"/>
                    <Setter Property="Foreground" Value="#FEE2E2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="12" UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="18" MinHeight="44" Padding="14,10,14,10"
                MaxWidth="640" HorizontalAlignment="Center"
                ClipToBounds="True" BorderBrush="#52525B" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#E827272A"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" BlurRadius="24" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <Button x:Name="DragHandle" Width="44" Height="44" Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseDown" ToolTip="Drag"
                        Background="Transparent" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                                        <Ellipse Width="3" Height="3" Fill="#71717A" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#71717A" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#71717A" Margin="1"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
                                        <Ellipse Width="3" Height="3" Fill="#71717A" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#71717A" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#71717A" Margin="1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="DashboardUserBtn" MinHeight="44" MaxWidth="168" Margin="8,0,0,0"
                        Padding="12,8" Click="DashboardLogo_Click" ToolTip="Open dashboard"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="UserBtnBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="UserBtnBorder" Property="Background" Value="#14FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="ToolbarUsernameText" Text="…"
                               FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7"
                               TextTrimming="CharacterEllipsis" MaxWidth="144" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="MicToggleBtn" Width="44" Height="44" Margin="8,0,0,0"
                        Click="MicToggle_Click" Cursor="Hand"
                        ToolTip="Listen (Ctrl+Shift+L)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ListenBtnBorder" Width="44" Height="44"
                                    Background="#332563EB" CornerRadius="22"
                                    BorderBrush="#2563EB" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <Grid>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="ListenIcon" Fill="#93C5FD"
                                                  Data="M12,10C10.34,10 9,11.34 9,13C9,14.66 10.34,16 12,16C13.66,16 15,14.66 15,13C15,11.34 13.66,10 12,10M16.24,7.76C17.32,8.85 18,10.35 18,12C18,13.65 17.32,15.15 16.24,16.24L14.83,14.83C15.55,14.11 16,13.11 16,12C16,10.89 15.55,9.89 14.83,9.17L16.24,7.76M19.07,4.93C20.88,6.74 22,9.24 22,12C22,14.76 20.88,17.26 19.07,19.07L17.66,17.66C19.11,16.21 20,14.21 20,12C20,9.79 19.11,7.79 17.66,6.34L19.07,4.93M4.93,19.07C3.12,17.26 2,14.76 2,12C2,9.24 3.12,6.74 4.93,4.93L6.34,6.34C4.89,7.79 4,9.79 4,12C4,14.21 4.89,16.21 6.34,17.66L4.93,19.07M7.76,16.24C6.68,15.15 6,13.65 6,12C6,10.35 6.68,8.85 7.76,7.76L9.17,9.17C8.45,9.89 8,10.89 8,12C8,13.11 8.45,14.11 9.17,14.83L7.76,16.24Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#DC2626"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,2,2,0" Visibility="Collapsed">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#DC2626" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="ListenBtnText" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ListenBtnBorder" Property="Background" Value="#4D2563EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border x:Name="LiveTimerPill" Visibility="Collapsed"
                        Margin="8,0,0,0" Height="28" MinWidth="64" Padding="10,0" VerticalAlignment="Center"
                        Background="#332563EB" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="14"
                        ToolTip="Live duration">
                    <Border.Effect>
                        <DropShadowEffect Color="#2563EB" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#DC2626" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="LiveTimerText" Text="00:00" Foreground="#DBEAFE"
                                   FontFamily="Consolas,Segoe UI" FontWeight="SemiBold" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="EndSessionBtn" Width="44" Height="44" Margin="8,0,0,0"
                        Click="EndSession_Click" ToolTip="End session — stop audio and clear transcript"
                        Background="Transparent" Foreground="#FCA5A5" BorderBrush="#7F1D1D" BorderThickness="1"
                        FontSize="10" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="22" Width="44" Height="44">
                                <TextBlock Text="End" Foreground="{TemplateBinding Foreground}" 
                                         FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3F1515"/>
                                    <Setter Property="Foreground" Value="#FEE2E2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="ExpandToggleBtn" Width="44" Height="44" Margin="8,0,0,0"
                        Style="{StaticResource ToolbarIconBtn}"
                        Click="ExpandToggle_Click" ToolTip="Expand / collapse Live Insights">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="ChevronIcon" Fill="#A1A1AA" Data="M12,8L6,14L7.41,15.41L12,10.83L16.59,15.41L18,14L12,8Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <ToggleButton x:Name="IslandBarToggle" Width="44" Height="44" Margin="8,0,0,0"
                              IsChecked="True" Cursor="Hand"
                              Checked="IslandBarToggle_Changed" Unchecked="IslandBarToggle_Changed"
                              ToolTip="Island Bar — ON: SnapEye is clickable. OFF: clicks pass through to the app behind (this button stays clickable).">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="IslandBorder" Width="44" Height="44" CornerRadius="22"
                                    Background="#332563EB" BorderBrush="#2563EB" BorderThickness="1">
                                <Grid>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="IslandIcon" Fill="#93C5FD"
                                                  Data="M13.64,21.97C13.14,22.21 12.54,22 12.31,21.5L10.13,16.76L7.62,18.78C7.45,18.92 7.24,19 7,19A1,1 0 0,1 6,18V3A1,1 0 0,1 7,2C7.24,2 7.47,2.09 7.64,2.23L7.65,2.22L19.14,11.86C19.57,12.22 19.62,12.85 19.27,13.27C19.12,13.45 18.91,13.57 18.7,13.61L15.54,14.23L17.74,18.96C18,19.46 17.76,20.05 17.26,20.28L13.64,21.97Z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Ellipse x:Name="IslandStateDot" Width="8" Height="8" Fill="#22C55E"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="IslandBorder" Property="Background" Value="#33F59E0B"/>
                                    <Setter TargetName="IslandBorder" Property="BorderBrush" Value="#F59E0B"/>
                                    <Setter TargetName="IslandIcon" Property="Fill" Value="#FCD34D"/>
                                    <Setter TargetName="IslandStateDot" Property="Fill" Value="#F59E0B"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="IslandBorder" Property="Background" Value="#4D2563EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Button x:Name="MenuBtn" Width="44" Height="44" Margin="8,0,0,0"
                        Style="{StaticResource ToolbarIconBtn}" Click="Menu_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="SettingsMenu">
                            <MenuItem Header="Invisible to capture" Click="Stealth_Click"/>
                            <MenuItem Header="Experience…" Click="Experience_Click"/>
                            <MenuItem Header="Keyboard shortcuts…" Click="KeyboardShortcuts_Click"/>
                            <MenuItem Header="New conversation" Click="NewConversation_Click"
                                      ToolTip="Start a fresh conversation thread (the current one is saved)"/>
                            <Separator/>
                            <MenuItem Header="Listen (Live)" Click="MicToggleFromMenu_Click" InputGestureText="Ctrl+Shift+L"/>
                            <MenuItem Header="Copy answer" Click="CopyAnswer_Click" InputGestureText="Ctrl+Shift+C"/>
                            <MenuItem Header="Screenshot / OCR" Click="Screenshot_Click" InputGestureText="Ctrl+Shift+S"/>
                            <MenuItem Header="Hide / show overlay" Click="ToggleOverlayVisibility_Click" InputGestureText="Ctrl+Shift+H"/>
                            <MenuItem Header="Expand Live Insights" Click="ExpandLiveInsights_MenuClick" InputGestureText="Ctrl+Shift+Up"/>
                            <MenuItem Header="Collapse Live Insights" Click="CollapseLiveInsights_MenuClick" InputGestureText="Ctrl+Shift+Down"/>
                            <Separator/>
                            <MenuItem Header="Opacity">
                                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Value="0.95" Width="120"
                                        ValueChanged="OpacitySlider_Changed"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Quit SnapEye" Click="Quit_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#A1A1AA" Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="CloseBtn" Width="44" Height="44" Margin="8,0,0,0"
                        Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="Hide overlay">
                    <Viewbox Width="10" Height="10">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#F4F4F5" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Border x:Name="InlineErrorPill" Visibility="Collapsed"
                        Margin="10,0,0,0" Height="26" Padding="10,0" VerticalAlignment="Center"
                        Background="#33991B1B" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="13"
                        MaxWidth="260" ClipToBounds="True" ToolTip="Connection or service issue">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="#FCA5A5" VerticalAlignment="Center"
                              Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"/>
                        <TextBlock x:Name="InlineErrorText" Text="" Foreground="#FEE2E2"
                                   FontSize="11" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

        <StackPanel x:Name="SessionBody" Grid.Row="1" Margin="0,10,0,0">
            <Border x:Name="LiveInsightsCard" CornerRadius="18" ClipToBounds="True"
                    BorderBrush="#52525B" BorderThickness="1">
                <Border.Background>
                    <SolidColorBrush Color="#E627272A"/>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270" BlurRadius="28" ShadowDepth="4" Opacity="0.35"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ContentRow" Height="420"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10,6,10,6" Background="#1AFFFFFF">
                        <Border.BorderBrush><SolidColorBrush Color="#3F3F46"/></Border.BorderBrush>
                        <Border.BorderThickness><Thickness>0,0,0,1</Thickness></Border.BorderThickness>
                        <StackPanel>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="8" Background="#3A3A40" BorderBrush="#52525B"
                                        BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center" Height="28">
                                    <ComboBox x:Name="ModeSelector" Style="{StaticResource DarkComboStyle}" SelectionChanged="ModeSelector_Changed"
                                              MinWidth="140" FontSize="12" Padding="6,0,22,0" MinHeight="26">
                                        <ComboBox.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2A2E"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4F4F5"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                                        </ComboBox.Resources>
                                    </ComboBox>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton x:Name="JobDetailsToggle" Content="Job details" Visibility="Collapsed"
                                                  Style="{StaticResource ToggleBtnStyle}" Checked="JobDetailsToggle_Changed"
                                                  Unchecked="JobDetailsToggle_Changed" Height="28" Padding="10,3"
                                                  VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                                    <ToggleButton x:Name="TranscriptToggle" Content="Transcript"
                                                  Style="{StaticResource ToggleBtnStyle}" Checked="TranscriptToggle_Changed"
                                                  Unchecked="TranscriptToggle_Changed" Height="28" Padding="10,3" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Optional, non-blocking job details for Interview Mode. Never shown as a
                                 popup - the mode's system_prompt already works standalone without these;
                                 filling them in just tailors answers to a specific role. -->
                            <StackPanel x:Name="JobDetailsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Text="COMPANY (OPTIONAL)" FontSize="9" Foreground="#A1A1AA" Margin="2,0,0,3"/>
                                <TextBox x:Name="JobCompanyBox" Margin="0,0,0,6"
                                         Background="#3A3A40" Foreground="#F4F4F5" BorderBrush="#52525B" BorderThickness="1"
                                         Padding="8,5" FontSize="12" LostFocus="JobDetailsField_LostFocus"/>
                                <TextBlock Text="ROLE (OPTIONAL)" FontSize="9" Foreground="#A1A1AA" Margin="2,0,0,3"/>
                                <TextBox x:Name="JobRoleBox" Margin="0,0,0,6"
                                         Background="#3A3A40" Foreground="#F4F4F5" BorderBrush="#52525B" BorderThickness="1"
                                         Padding="8,5" FontSize="12" LostFocus="JobDetailsField_LostFocus"/>
                                <TextBlock Text="JOB DESCRIPTION (OPTIONAL)" FontSize="9" Foreground="#A1A1AA" Margin="2,0,0,3"/>
                                <TextBox x:Name="JobDescriptionBox" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"
                                         Background="#3A3A40" Foreground="#F4F4F5" BorderBrush="#52525B" BorderThickness="1"
                                         Padding="8,5" FontSize="12" LostFocus="JobDetailsField_LostFocus"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <solution:SolutionRegionAlpha x:Name="AlphaRegion" Grid.Row="1"/>

                    <Border Grid.Row="2" Padding="10,6,10,6">
                        <Border.BorderBrush><SolidColorBrush Color="#3F3F46"/></Border.BorderBrush>
                        <Border.BorderThickness><Thickness>0,1,0,1</Thickness></Border.BorderThickness>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel x:Name="QuickActionsPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StopBtn" Width="30" Height="30" Margin="6,0,0,0"
                                        Click="StopBtn_Click" ToolTip="Stop / cancel the current response (Esc)"
                                        Cursor="Hand" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StopBorder" Width="30" Height="30" CornerRadius="15"
                                                    Background="#33DC2626" BorderBrush="#DC2626" BorderThickness="1">
                                                <Viewbox Width="14" Height="14">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#FCA5A5" Data="M6,6H18V18H6V6Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="StopBorder" Property="Background" Value="#4DDC2626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="RegenBtn" Width="30" Height="30" Margin="6,0,0,0"
                                        Click="RegenBtn_Click" ToolTip="Answer again — same question, different explanation"
                                        Cursor="Hand" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RegenBorder" Width="30" Height="30" CornerRadius="15"
                                                    Background="#3316A34A" BorderBrush="#16A34A" BorderThickness="1">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#86EFAC" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RegenBorder" Property="Background" Value="#4D16A34A"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="RegenBorder" Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="CameraBtn" Width="30" Height="30" Margin="6,0,0,0"
                                        Click="CameraBtn_Click" ToolTip="Capture screen and extract text (Ctrl+Shift+S)"
                                        Cursor="Hand" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CamBorder" Width="30" Height="30" CornerRadius="15"
                                                    Background="#332563EB" BorderBrush="#2563EB" BorderThickness="1">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#93C5FD" Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CamBorder" Property="Background" Value="#4D2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ToggleButton x:Name="MicMuteBtn" Width="30" Height="30" Margin="6,0,0,0"
                                              Checked="MicMuteBtn_Changed" Unchecked="MicMuteBtn_Changed"
                                              ToolTip="Mute microphone (` + Space)"
                                              Cursor="Hand" VerticalAlignment="Center">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="MicBorder" Width="30" Height="30" CornerRadius="15"
                                                    Background="#332563EB" BorderBrush="#2563EB" BorderThickness="1">
                                                <Grid>
                                                    <Viewbox x:Name="MicOnIcon" Width="16" Height="16">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="#93C5FD" Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Viewbox x:Name="MicOffIcon" Width="16" Height="16" Visibility="Collapsed">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="#FCA5A5" Data="M19,11C19,12.19 18.66,13.3 18.1,14.28L16.87,13.05C17.14,12.43 17.3,11.74 17.3,11H19M15,11.16L9,5.18V5A3,3 0 0,1 12,2A3,3 0 0,1 15,5V11.16M4.27,3L21,19.73L19.73,21L15.54,16.81C14.77,17.27 13.91,17.58 13,17.72V21H11V17.72C7.72,17.23 5,14.41 5,11H6.7C6.7,14 9.24,16.1 12,16.1C12.81,16.1 13.6,15.91 14.31,15.58L12.65,13.92L12,14A3,3 0 0,1 9,11V10.28L3,4.27L4.27,3Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MicBorder" Property="Background" Value="#4D2563EB"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="MicBorder" Property="Background" Value="#33DC2626"/>
                                                    <Setter TargetName="MicBorder" Property="BorderBrush" Value="#DC2626"/>
                                                    <Setter TargetName="MicOnIcon" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="MicOffIcon" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Padding="14,10,14,14" Background="#1AFFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="12" Background="#323236" BorderBrush="#3F3F46" BorderThickness="1" Padding="12,2" MinHeight="44">
                                <TextBox x:Name="ChatInput" Background="Transparent" Foreground="#F4F4F5" BorderThickness="0"
                                         FontSize="14" FontFamily="Segoe UI" VerticalContentAlignment="Center" CaretBrush="#F4F4F5"
                                         Cursor="IBeam" Text="" AcceptsReturn="False" KeyDown="ChatInput_KeyDown" MaxHeight="120">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid VerticalAlignment="Center" Background="Transparent">
                                                <TextBlock x:Name="PlaceholderText" Text="Ask AI about your call, screen, or transcript…"
                                                           Foreground="#71717A" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Border>
                            <Button x:Name="SendBtn" Grid.Column="2" Width="44" Height="44" Click="Send_Click" ToolTip="Send (Ctrl+Enter)" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SendBorder" Background="#2563EB" CornerRadius="9999">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#2563EB" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                                            </Border.Effect>
                                            <Viewbox Width="18" Height="18" Margin="12">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="White" Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SendBorder" Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</Window>
