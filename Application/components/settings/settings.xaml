<UserControl x:Class="SnapEye.Settings.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <StackPanel Orientation="Horizontal">
        <!-- Visibility Toggle Switch -->
        <Border Background="#2A2A2A"
                CornerRadius="12"
                Padding="8,4"
                Margin="0,0,8,0"
                ToolTip="Toggle Visibility">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#00D9FF" Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
                    </Canvas>
                </Viewbox>
                
                <ToggleButton x:Name="VisibilityToggle"
                              Width="36"
                              Height="18"
                              Checked="VisibilityToggle_Checked"
                              Unchecked="VisibilityToggle_Unchecked"
                              IsChecked="True"
                              Cursor="Hand">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <!-- Background Track -->
                                            <Border x:Name="TrackBorder"
                                                    Background="#3A3A3A"
                                                    CornerRadius="9"
                                                    Width="36"
                                                    Height="18"/>
                                            
                                            <!-- Thumb -->
                                            <Border x:Name="ThumbBorder"
                                                    Background="#888888"
                                                    CornerRadius="7"
                                                    Width="14"
                                                    Height="14"
                                                    HorizontalAlignment="Left"
                                                    Margin="2,0,0,0"/>
                                        </Grid>
                                        
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TrackBorder" Property="Background" Value="#00D9FF"/>
                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FFFFFF"/>
                                                <Setter TargetName="ThumbBorder" Property="Margin" Value="20,0,0,0"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TrackBorder" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
        </Border>
        
        <!-- Quit Button -->
        <Button x:Name="QuitBtn"
                Width="20"
                Height="20"
                Background="#2A2A2A"
                BorderThickness="0"
                Cursor="Hand"
                Click="QuitBtn_Click"
                ToolTip="Quit SnapEye">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="20">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FF4444" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3A3A3A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#1A1A1A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>

