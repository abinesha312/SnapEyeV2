<Window x:Class="SnapEye.Dashboard.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="SnapEye - Authentication"
        Icon="pack://application:,,,/SnapEye;component/Public/Logo/01_Logo_v1.png"
        Height="820" Width="1280"
        MinHeight="640" MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Button Style -->
        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A7BFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A64CC"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3A7BFF" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#553A7BFF"/>
                                <Setter Property="BorderBrush" Value="#993A7BFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#773A7BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Input Style -->
        <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#6EC1FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#6EC1FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav item -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6B6478"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#D6EBFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#3A7BFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password Box Style -->
        <Style x:Key="GlassPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#6EC1FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#6EC1FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with White Background -->
    <Grid>
        <!-- White Background -->
        <Border Background="{StaticResource AppBackgroundBrush}"/>
        
        <!-- Main Content Border -->
        <Border Background="#FFFFFF" CornerRadius="20" Margin="10">
            <Border.Effect>
                <DropShadowEffect Color="#3A7BFF" BlurRadius="40" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with Maximize + Close buttons -->
                <Grid Grid.Row="0" Margin="20,20,20,10" MouseDown="Header_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Image Source="pack://application:,,,/SnapEye;component/Public/Logo/01_Logo_v1.png"
                               Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,14,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SnapEye AI" FontSize="28" FontWeight="Bold" Foreground="#333333"/>
                            <TextBlock Text="Authentication Dashboard" FontSize="14" Foreground="#666666" Margin="0,5,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="MaximizeButton"
                            Width="40" Height="40" Margin="0,0,8,0"
                            Background="#156EC1FF"
                            Foreground="#3A7BFF"
                            BorderBrush="#336EC1FF"
                            BorderThickness="1"
                            Click="MaximizeButton_Click"
                            Cursor="Hand"
                            ToolTip="Maximize / Restore">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20">
                                    <Path x:Name="MaxIcon" Width="14" Height="14" Stretch="Uniform"
                                          Stroke="#2E5FA8" StrokeThickness="1.6" Fill="Transparent"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M3,3 H13 V13 H3 Z"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="✕"
                            Width="40" Height="40"
                            FontSize="20"
                            Background="#33FF0000"
                            Foreground="#FFFFFF"
                            BorderBrush="#66FF0000"
                            BorderThickness="1"
                            Click="CloseButton_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="40,20,40,40">
                    <!-- Login Panel -->
                    <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" MaxWidth="400">
                        <Image Source="pack://application:,,,/SnapEye;component/Public/Logo/01_Logo_v1.png"
                               Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,16"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Sign In" FontSize="24" FontWeight="Bold" Foreground="#333333" 
                                   HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <!-- Username Field -->
                        <TextBlock Text="Username" FontSize="12" Foreground="#666666" Margin="0,0,0,8"/>
                        <TextBox x:Name="UsernameTextBox" 
                                 Style="{StaticResource GlassTextBoxStyle}"
                                 Height="45"
                                 Margin="0,0,0,20"
                                 KeyDown="InputField_KeyDown"/>

                        <!-- API Key Field -->
                        <TextBlock Text="API Key" FontSize="12" Foreground="#666666" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     Style="{StaticResource GlassPasswordBoxStyle}"
                                     Height="45"
                                     Margin="0,0,0,30"
                                     KeyDown="InputField_KeyDown"/>

                        <!-- Error Message -->
                        <TextBlock x:Name="ErrorTextBlock"
                                   Foreground="#FF6B6B"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"
                                   Visibility="Collapsed"/>

                        <!-- Login Button -->
                        <Button x:Name="LoginButton"
                                Content="Sign In"
                                Style="{StaticResource GlassButtonStyle}"
                                Height="50"
                                Click="LoginButton_Click"
                                Margin="0,0,0,15"/>

                        <!-- Loading Indicator -->
                        <StackPanel x:Name="LoadingPanel" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed"
                                    Margin="0,10,0,0">
                            <TextBlock Text="●" FontSize="20" Foreground="#3A7BFF" Margin="5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                               From="0" To="360" Duration="0:0:2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="Authenticating..." FontSize="14" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Info Text -->
                        <TextBlock TextWrapping="Wrap" 
                                   FontSize="11" 
                                   Foreground="#888888" 
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,20,0,0">
                            <Run Text="Enter your credentials to access SnapEye AI"/>
                            <LineBreak/>
                            <Run Text="Session will be stored securely for 90 days"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Profile Panel (post-login): left sidebar + content area -->
                    <Grid x:Name="ProfilePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar -->
                        <Border Grid.Column="0" Background="#F0F7FF" BorderBrush="#B8D9F0" BorderThickness="0,0,1,0" CornerRadius="12,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Signed-in user only (no separate product title) -->
                                <StackPanel Grid.Row="0" Margin="16,18,16,8">
                                    <TextBlock x:Name="SidebarUsername" FontSize="18" FontWeight="Bold" Foreground="#333333"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Border Grid.Row="1" Height="1" Background="#B8D9F0" Margin="16,6,16,10"/>

                                <!-- Nav list -->
                                <StackPanel Grid.Row="2" Margin="10,0">
                                    <RadioButton x:Name="NavLaunch" GroupName="DashNav" IsChecked="True"
                                                 Style="{StaticResource NavItemStyle}" Checked="NavLaunch_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#6B6478"
                                                  Data="M4,4H8V8H4V4M10,4H20V8H10V4M4,10H8V20H4V10M10,10H20V20H10V10Z"/>
                                            <TextBlock Text="Launch application" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavConversations" GroupName="DashNav"
                                                 Style="{StaticResource NavItemStyle}" Checked="NavConversations_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#6B6478"
                                                  Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M6,9H18V11H6V9M14,14H6V12H14V14M18,8H6V6H18V8Z"/>
                                            <TextBlock Text="Conversations" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavPrompts" GroupName="DashNav"
                                                 Style="{StaticResource NavItemStyle}" Checked="NavPrompts_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#6B6478"
                                                  Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M8,12V14H16V12H8M8,16V18H13V16H8Z"/>
                                            <TextBlock Text="Prompts" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavAiModels" GroupName="DashNav"
                                                 Style="{StaticResource NavItemStyle}" Checked="NavAiModels_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#6B6478"
                                                  Data="M17,17H7V7H17M21,11V9H19V7A2,2 0 0,0 17,5H15V3H13V5H11V3H9V5H7A2,2 0 0,0 5,7V9H3V11H5V13H3V15H5V17A2,2 0 0,0 7,19H9V21H11V19H13V21H15V19H17A2,2 0 0,0 19,17V15H21V13H19V11M13,13H11V11H13M15,9H9V15H15V9Z"/>
                                            <TextBlock Text="AI Models" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavExperience" GroupName="DashNav"
                                                 Style="{StaticResource NavItemStyle}" Checked="NavExperience_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#6B6478"
                                                  Data="M10,2H14A2,2 0 0,1 16,4V6H20A2,2 0 0,1 22,8V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V8A2,2 0 0,1 4,6H8V4A2,2 0 0,1 10,2M14,6V4H10V6H14Z"/>
                                            <TextBlock Text="Experience" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavShortcuts" GroupName="DashNav"
                                                 Style="{StaticResource NavItemStyle}" Checked="NavShortcuts_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#6B6478"
                                                  Data="M7,14H5V19H10V17H7V14M7,10H5V5H10V7H7V10M14,5H19V10H17V7H14V5M17,17H14V19H19V14H17V17M17,12H19V14H17V12M12,17H14V19H12V17M12,7H14V5H12V7Z"/>
                                            <TextBlock Text="Shortcuts" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>

                                <!-- Footer: sign-out -->
                                <Button Grid.Row="3" x:Name="SidebarSignOutBtn" Click="SignOutButton_Click"
                                        Margin="12,10,12,14" Height="36" Cursor="Hand"
                                        HorizontalContentAlignment="Left">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="SignOutBorder" Background="Transparent" CornerRadius="8" Padding="12,0" BorderBrush="#B8D9F0" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="#B84848"
                                                          Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z"/>
                                                    <TextBlock Text="Sign out" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               FontSize="13" FontWeight="SemiBold" Foreground="#B84848"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SignOutBorder" Property="Background" Value="#FFF4F4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content area -->
                        <Grid Grid.Column="1" Margin="24,16,24,16">
                            <!-- Launch Application view -->
                            <StackPanel x:Name="LaunchView" VerticalAlignment="Top">
                                <TextBlock Text="Welcome Back!" FontSize="22" FontWeight="Bold" Foreground="#333333" Margin="0,4,0,18"/>

                                <Border Background="#F9F9F9"
                                        BorderBrush="#3A7BFF"
                                        BorderThickness="2"
                                        CornerRadius="12"
                                        Padding="20"
                                        Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                            <TextBlock Text="Username" FontSize="11" Foreground="#888888" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="ProfileUsername" FontSize="16" Foreground="#333333" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                            <TextBlock Text="Session Expires" FontSize="11" Foreground="#888888" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="ProfileExpiry" FontSize="14" Foreground="#555555"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Margin="0,0,0,15">
                                            <TextBlock Text="Token Status" FontSize="11" Foreground="#888888" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ProfileStatus" Text="Active" FontSize="14" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3">
                                            <TextBlock Text="Last Login" FontSize="11" Foreground="#888888" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="ProfileLastLogin" FontSize="12" Foreground="#666666"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button Content="Launch SnapEye"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Height="48" MinWidth="240"
                                        HorizontalAlignment="Center"
                                        Padding="40,10"
                                        Margin="0,4,0,0"
                                        Click="LaunchButton_Click"/>
                            </StackPanel>

                            <!-- Conversations view (master-detail) -->
                            <Grid x:Name="ConversationsView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Conversations" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                                        <TextBlock x:Name="ConversationsSubtitle" Text="Select a past meeting to view its messages."
                                                   FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="RefreshConversationsBtn" Click="RefreshConversations_Click"
                                            Height="34" Padding="14,0" VerticalAlignment="Top" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RefreshBorder" Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#6B6478"
                                                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                                        <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#6B6478" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RefreshBorder" Property="Background" Value="#D6EBFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Master: list of sessions -->
                                    <Border Grid.Column="0" Background="#FAFAFC" BorderBrush="#E6E3EF" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,6">
                                                <StackPanel x:Name="ConversationsList"/>
                                            </ScrollViewer>
                                            <TextBlock x:Name="ConversationsEmpty"
                                                       Text="No past conversations yet.&#x0a;Finish a meeting and your history will appear here."
                                                       Foreground="#A9A3B8" FontSize="12" TextWrapping="Wrap"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextAlignment="Center" Margin="12"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>

                                    <!-- Detail: messages of the selected session -->
                                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E6E3EF" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="#F2F8FC" BorderBrush="#E6E3EF" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="16,12">
                                                <StackPanel>
                                                    <TextBlock x:Name="DetailTitle" Text="Select a conversation" FontSize="15" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DetailMeta" Text="" FontSize="11" Foreground="#8A8394" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                                                <StackPanel x:Name="DetailThread"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Prompts view: accordion list of custom system prompts per mode -->
                            <Grid x:Name="PromptsView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header: title + action buttons -->
                                <Grid Grid.Row="0" Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prompts" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                                        <TextBlock Text="Customize the system prompt the AI uses in each mode. Saved locally on this machine."
                                                   FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="AddModeBtn" Click="AddMode_Click"
                                            Height="34" Padding="14,0" Margin="0,0,8,0" VerticalAlignment="Top" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AddBorder" Background="#3A7BFF" BorderBrush="#2A64CC" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF"
                                                              Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                                                        <TextBlock Text="Add mode" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AddBorder" Property="Background" Value="#2B5EC8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="2" x:Name="ResetAllBtn" Click="ResetAllDefaults_Click"
                                            Height="34" Padding="14,0" VerticalAlignment="Top" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ResetBorder" Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#6B6478"
                                                              Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                                        <TextBlock Text="Reset all" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#6B6478" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ResetBorder" Property="Background" Value="#D6EBFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Inline error banner, shown only when prompts.json fails to parse -->
                                <Border Grid.Row="1" x:Name="PromptsErrorBanner" Visibility="Collapsed"
                                        Background="#FFF4F4" BorderBrush="#F5B5B5" BorderThickness="1" CornerRadius="8"
                                        Padding="12,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="PromptsErrorText"
                                                   Foreground="#A13838" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Reset to defaults" Click="ResetAllDefaults_Click"
                                                Cursor="Hand" Margin="12,0,0,0" Padding="10,4" FontSize="11"
                                                Background="#B84848" Foreground="#FFFFFF" BorderBrush="#9A3A3A" BorderThickness="1">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Accordion list of modes -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                    <Grid>
                                        <ItemsControl x:Name="PromptsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E6E3EF" BorderThickness="1"
                                                            CornerRadius="10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Header row (always visible) -->
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Expand/collapse toggle area: clicking the name expands -->
                                                                <Button Grid.Column="0" Tag="{Binding Id}" Click="PromptRowExpand_Click"
                                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                        Padding="12,12" HorizontalContentAlignment="Left">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#8A8394"
                                                                              Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                                              Margin="0,0,8,0">
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#8A8394"
                                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                                              Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                                                                              Margin="0,0,8,0"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                               Foreground="#333333" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    <Border Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1"
                                                                            CornerRadius="10" Margin="10,0,0,0" Padding="8,2"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Icon}" FontSize="10" Foreground="#6B6478"/>
                                                                    </Border>
                                                                    <TextBlock Text="custom" FontSize="10" Foreground="#B84848" Margin="8,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                    <Button Tag="{Binding Id}" Click="PromptRowUp_Click" ToolTip="Move up"
                                                                            Width="28" Height="28" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="UpBorder" Background="Transparent" CornerRadius="14">
                                                                                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#6B6478"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="UpBorder" Property="Background" Value="#F2F8FC"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Tag="{Binding Id}" Click="PromptRowDown_Click" ToolTip="Move down"
                                                                            Width="28" Height="28" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="DownBorder" Background="Transparent" CornerRadius="14">
                                                                                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#6B6478"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="DownBorder" Property="Background" Value="#F2F8FC"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Tag="{Binding Id}" Click="PromptRowDelete_Click" ToolTip="Delete mode"
                                                                            Width="28" Height="28" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="4,0,0,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="DelBorder" Background="Transparent" CornerRadius="14">
                                                                                    <Path Width="12" Height="12" Stretch="Uniform" Fill="#B84848"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8.46,11.88L9.87,10.47L12,12.59L14.12,10.47L15.53,11.88L13.41,14L15.53,16.12L14.12,17.53L12,15.41L9.88,17.53L8.47,16.12L10.59,14L8.46,11.88M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="DelBorder" Property="Background" Value="#FFF4F4"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Expanded body -->
                                                            <Border Grid.Row="1" Background="#FAFAFC" BorderBrush="#E6E3EF" BorderThickness="0,1,0,0"
                                                                    CornerRadius="0,0,10,10"
                                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Margin="14,12,14,14">
                                                                    <TextBlock Text="Name" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="13" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1"
                                                                             Background="#FFFFFF" Margin="0,0,0,10"/>

                                                                    <TextBlock Text="Icon" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding Icon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="13" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1"
                                                                             Background="#FFFFFF" Margin="0,0,0,10"
                                                                             ToolTip="Free-form text tag shown next to the mode name."/>

                                                                    <TextBlock Text="System prompt" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="12" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1"
                                                                             Background="#FFFFFF"
                                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                                             MinHeight="120" MaxHeight="260"
                                                                             VerticalScrollBarVisibility="Auto"/>

                                                                    <Grid Margin="0,12,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" x:Name="RowSavedLabel"
                                                                                   Text="{Binding StatusText}"
                                                                                   FontSize="11" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                                                        <Button Grid.Column="1" Tag="{Binding Id}" Click="PromptRowReset_Click"
                                                                                Content="Reset to default" Cursor="Hand"
                                                                                Margin="0,0,8,0" Padding="12,6" FontSize="12"
                                                                                Background="#F2F8FC" Foreground="#6B6478" BorderBrush="#C5DFF8" BorderThickness="1"
                                                                                IsEnabled="{Binding HasBuiltInDefault}">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                                                                            Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                        <Button Grid.Column="2" Tag="{Binding Id}" Click="PromptRowSave_Click"
                                                                                Content="Save" Cursor="Hand"
                                                                                Padding="18,6" FontSize="12" FontWeight="SemiBold"
                                                                                Background="#3A7BFF" Foreground="#FFFFFF" BorderBrush="#2A64CC" BorderThickness="1">
                                                                            <Button.Template>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                                                                            Padding="{TemplateBinding Padding}">
                                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                    </Border>
                                                                                </ControlTemplate>
                                                                            </Button.Template>
                                                                        </Button>
                                                                    </Grid>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock x:Name="PromptsEmpty"
                                                   Text="No modes yet. Click + Add mode to create one."
                                                   Foreground="#A9A3B8" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                                   Margin="0,40,0,0" Visibility="Collapsed"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- AI Models view: pick provider + model, paste key, test connection -->
                            <Grid x:Name="AiModelsView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,4,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="AI Models" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                                        <TextBlock Text="Choose the AI provider and model SnapEye uses for every non-voice reply. Keys stay on this machine."
                                                   FontSize="12" Foreground="#888888" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Live status pill -->
                                    <Border Grid.Column="1" x:Name="AiStatusPill"
                                            Background="#EBF4FC" BorderBrush="#A8C8EE" BorderThickness="1"
                                            CornerRadius="999" Padding="12,6" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="AiStatusDot" Width="8" Height="8" Fill="#B5ADC2" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="AiStatusText" Text="NOT TESTED" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#6B6478"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                    <StackPanel>
                                        <!-- Provider cards row -->
                                        <TextBlock Text="Provider" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#6B6478" Margin="2,0,0,8"/>
                                        <UniformGrid x:Name="ProviderCardsGrid" Columns="4" Rows="1"/>

                                        <!-- Model + endpoint -->
                                        <Grid Margin="0,24,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Model" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#6B6478" Margin="2,0,0,8"/>
                                                <Border Background="#FFFFFF" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8">
                                                    <ComboBox x:Name="AiModelCombo" Height="40" Padding="12,0"
                                                              BorderThickness="0" Background="Transparent"
                                                              FontSize="13" Foreground="#333333"
                                                              SelectionChanged="AiModelCombo_SelectionChanged"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Endpoint (read-only)" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#6B6478" Margin="2,0,0,8"/>
                                                <Border Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <TextBlock x:Name="AiEndpointText" Text="" FontSize="12"
                                                               Foreground="#6B6478" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- API key -->
                                        <TextBlock Text="API key" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#6B6478" Margin="2,20,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8">
                                                <Grid>
                                                    <PasswordBox x:Name="AiApiKeyBox" Height="40" Padding="12,0" FontSize="13"
                                                                 Foreground="#333333" Background="Transparent" BorderThickness="0"
                                                                 VerticalContentAlignment="Center"
                                                                 PasswordChanged="AiApiKey_Changed"/>
                                                    <TextBox x:Name="AiApiKeyVisibleBox" Height="40" Padding="12,0" FontSize="13"
                                                             Foreground="#333333" Background="Transparent" BorderThickness="0"
                                                             VerticalContentAlignment="Center" Visibility="Collapsed"
                                                             TextChanged="AiApiKeyVisible_Changed"/>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="1" x:Name="ToggleKeyVisBtn" Click="TogglePasswordVisibility_Click"
                                                    Width="40" Height="40" Margin="8,0,0,0" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0" ToolTip="Show/hide key">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="EyeBorder" Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8">
                                                            <Path x:Name="EyeIcon" Width="14" Height="14" Stretch="Uniform" Fill="#6B6478"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="EyeBorder" Property="Background" Value="#D6EBFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                        <TextBlock x:Name="AiKeyHint" Text="Keys are encrypted with Windows DPAPI and stored locally in %APPDATA%\SnapEye\ai_models.json."
                                                   FontSize="11" Foreground="#A9A3B8" Margin="2,8,0,0" TextWrapping="Wrap"/>

                                        <!-- Actions -->
                                        <Grid Margin="0,24,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" x:Name="TestConnectionBtn" Click="TestConnection_Click"
                                                    Height="40" Padding="18,0" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="TestBorder" Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse x:Name="TestDot" Width="8" Height="8" Fill="#6B6478" Margin="0,0,8,0"/>
                                                                <TextBlock Text="Test connection" FontSize="13" FontWeight="SemiBold" Foreground="#6B6478"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="TestBorder" Property="Background" Value="#D6EBFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="TestBorder" Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <TextBlock Grid.Column="1" x:Name="AiInlineError" Text="" Foreground="#B84848"
                                                       FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                                                       TextWrapping="Wrap" MaxHeight="60"/>

                                            <Button Grid.Column="2" x:Name="SaveAiModelsBtn" Click="SaveAiModels_Click"
                                                    Height="40" Padding="24,0" Cursor="Hand" IsEnabled="False">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="SaveBorder" BorderBrush="#2A64CC" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#3A7BFF" Offset="0"/>
                                                                    <GradientStop Color="#2A64CC" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="SaveBorder" Property="Opacity" Value="0.45"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Keyboard shortcuts (settings-style reference) -->
                            <Grid x:Name="ShortcutsView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,4,0,16">
                                    <TextBlock Text="Keyboard shortcuts" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                                    <TextBlock Text="Every shortcut in one place. Global shortcuts work even when another app is focused."
                                               FontSize="12" Foreground="#888888" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                    <StackPanel>
                                        <ItemsControl x:Name="ShortcutsItemsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#C5DFF8" BorderThickness="1"
                                                            CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="14" Foreground="#333333"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#777777"
                                                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#E8F4FF" CornerRadius="8" Padding="10,6" Margin="14,0,0,0"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Keys}" FontFamily="Consolas,Segoe UI" FontSize="12"
                                                                           FontWeight="SemiBold" Foreground="#355A8C"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ShortcutsPrivacyNote" FontSize="12" Foreground="#888888"
                                                   TextWrapping="Wrap" Margin="2,8,0,0" LineHeight="18"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Experience view: manage companies/roles + education used to ground answers -->
                            <Grid x:Name="ExperienceView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Experience" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
                                        <TextBlock Text="Add your companies, roles and education. Answers are grounded in these in real time and spoken in your voice."
                                                   FontSize="12" Foreground="#888888" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="AddExperienceBtn" Click="AddExperience_Click"
                                            Height="34" Padding="14,0" Margin="0,0,8,0" VerticalAlignment="Top" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AddExpBorder" Background="#3A7BFF" BorderBrush="#2A64CC" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF"
                                                              Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                                                        <TextBlock Text="Add experience" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AddExpBorder" Property="Background" Value="#2B5EC8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="2" x:Name="AddEducationBtn" Click="AddEducation_Click"
                                            Height="34" Padding="14,0" VerticalAlignment="Top" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AddEduBorder" Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1" CornerRadius="8" Padding="12,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#6B6478"
                                                              Data="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z"/>
                                                        <TextBlock Text="Add education" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#6B6478" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AddEduBorder" Property="Background" Value="#D6EBFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                    <Grid>
                                        <ItemsControl x:Name="ExperienceList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#FFFFFF" BorderBrush="#E6E3EF" BorderThickness="1"
                                                            CornerRadius="10" Margin="0,0,0,10" Padding="14,12">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" HorizontalAlignment="Left"
                                                                        Background="#F2F8FC" BorderBrush="#C5DFF8" BorderThickness="1"
                                                                        CornerRadius="10" Padding="8,2">
                                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="#6B6478" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Button Grid.Column="1" Tag="{Binding}" Click="DeleteExperience_Click"
                                                                        ToolTip="Remove" Width="28" Height="28" Cursor="Hand"
                                                                        Background="Transparent" BorderThickness="0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="ExpDelBorder" Background="Transparent" CornerRadius="14">
                                                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="#B84848"
                                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                      Data="M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8.46,11.88L9.87,10.47L12,12.59L14.12,10.47L15.53,11.88L13.41,14L15.53,16.12L14.12,17.53L12,15.41L9.88,17.53L8.47,16.12L10.59,14L8.46,11.88M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="ExpDelBorder" Property="Background" Value="#FFF4F4"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </Grid>

                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="12"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding CompanyLabel}" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="13" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="{Binding RoleLabel}" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding Role, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="13" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="12"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="Start (e.g. Jan 2022)" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="13" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="End (e.g. Present)" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                                    <TextBox Text="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="13" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock Text="{Binding SummaryLabel}" FontSize="11" Foreground="#888888" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="12" Padding="8,6" BorderBrush="#C5DFF8" BorderThickness="1" Background="#FFFFFF"
                                                                     AcceptsReturn="True" TextWrapping="Wrap"
                                                                     MinHeight="90" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>

                                                            <Grid Margin="0,12,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                                           FontSize="11" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1" Tag="{Binding}" Click="SaveExperience_Click"
                                                                        Content="Save" Cursor="Hand"
                                                                        Padding="18,6" FontSize="12" FontWeight="SemiBold"
                                                                        Background="#3A7BFF" Foreground="#FFFFFF" BorderBrush="#2A64CC" BorderThickness="1">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                                                                    Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock x:Name="ExperienceEmpty"
                                                   Text="No experience yet. Click + Add experience to create one."
                                                   Foreground="#A9A3B8" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                                   Margin="0,40,0,0" Visibility="Collapsed"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

