<UserControl x:Class="SnapEye.Nav.PopupRangeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <UserControl.Resources>
        <!-- Slider Thumb Style -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#B794F7" Stroke="#FFFFFF" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Slider Track Style -->
        <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Width="4" Background="#3A3A3A" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!-- Icon Button -->
        <Button x:Name="IconButton"
                Width="24"
                Height="24"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="IconButton_Click">
            <TextBlock Text="🔊" FontSize="18"/>
        </Button>
        
        <!-- Popup Slider -->
        <Popup x:Name="SliderPopup"
               PlacementTarget="{Binding ElementName=IconButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               Closed="SliderPopup_Closed">
            
            <Border CornerRadius="12"
                    Padding="12"
                    BorderThickness="1"
                    Margin="0,0,0,10">
                
                <!-- Glassmorphism Background -->
                <Border.Background>
                    <SolidColorBrush Color="#CC1A1A1A" Opacity="0.8"/>
                </Border.Background>
                
                <!-- Purple Glossy Border -->
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#60B794F7" Offset="0"/>
                        <GradientStop Color="#30B794F7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                
                <!-- Subtle Shadow -->
                <Border.Effect>
                    <DropShadowEffect Color="#B794F7" Direction="0" 
                                      ShadowDepth="0" BlurRadius="15" Opacity="0.4"/>
                </Border.Effect>
                
                <StackPanel Width="40">
                    <!-- Value Display -->
                    <TextBlock x:Name="ValueDisplay"
                               Text="50"
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    
                    <!-- Vertical Slider -->
                    <Slider x:Name="VerticalSlider"
                            Orientation="Vertical"
                            Height="120"
                            Minimum="0"
                            Maximum="100"
                            Value="50"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="VerticalSlider_ValueChanged">
                        <Slider.Style>
                            <Style TargetType="Slider">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <Track x:Name="PART_Track" Grid.Row="1">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="Slider.DecreaseLarge">
                                                            <RepeatButton.Style>
                                                                <Style TargetType="RepeatButton">
                                                                    <Setter Property="SnapsToDevicePixels" Value="true"/>
                                                                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                                                                    <Setter Property="IsTabStop" Value="false"/>
                                                                    <Setter Property="Focusable" Value="false"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="RepeatButton">
                                                                                <Border Width="4" Background="#B794F7" CornerRadius="2"/>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </RepeatButton.Style>
                                                        </RepeatButton>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="Slider.IncreaseLarge" 
                                                                      Style="{StaticResource SliderRepeatButtonStyle}"/>
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Slider.Style>
                    </Slider>
                    
                    <!-- Icon at bottom -->
                    <TextBlock Text="🔊"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Opacity="0.5"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

