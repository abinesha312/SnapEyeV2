<UserControl x:Class="SnapEye.SolutionRegion.SolutionRegionAlpha"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf">
    
    <UserControl.Resources>
        <!-- Markdown text styles for dark theme -->
        <Style TargetType="Paragraph">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
        </Style>
        <Style TargetType="Run">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        <Style TargetType="Section">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CodeBlockStyle" TargetType="Section">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2D7FF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>
        <Style x:Key="CodeStyle" TargetType="Inline">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#5B9CF9"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
        </Style>
        
        <!-- Thin Scrollbar -->
        <Style x:Key="ContentScrollbar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Background" Value="#25FFFFFF"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2D7FF9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid x:Name="ContentGrid" Background="Transparent">
        <!-- Chat / AI Insights View -->
        <ScrollViewer x:Name="ChatView" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Visible"
                      Padding="12,8">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ContentScrollbar}"/>
            </ScrollViewer.Resources>
            
            <markdig:MarkdownViewer x:Name="MarkdownViewer"
                                    Background="Transparent"
                                    Foreground="#E0E0E0"
                                    Margin="0"
                                    Markdown="**Welcome to SnapEye AI**&#x0a;&#x0a;Select a mode above, then start listening or ask a question below."/>
        </ScrollViewer>
        
        <!-- Transcription View -->
        <ScrollViewer x:Name="TranscriptionView"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed"
                      Padding="8,4">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ContentScrollbar}"/>
            </ScrollViewer.Resources>
            
            <StackPanel x:Name="TranscriptionPanel" Margin="0">
                <!-- Placeholder -->
                <TextBlock x:Name="TranscriptPlaceholder"
                           Text="Start listening to see live transcription..."
                           Foreground="#6B7280" FontSize="11" FontStyle="Italic"
                           FontFamily="Segoe UI"
                           Margin="4,8" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
