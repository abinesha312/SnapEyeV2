# Secrets / local env (never commit)
.env
.env.*
!.env.example
backend/.env

# --- SnapEye app local data ---
# Large Tesseract language data (download/install locally)
backend/tessdata/

# Local SQLite / chroma / runtime data if present under backend
backend/data/*.db
backend/data/*.db-*
backend/**/chroma*/
backend/logs/

# Focus Detect live log (regenerated locally)
Detect/data/
Detect/**/*.tmp

# Copied config next to built exe (use Application/config source instead)
Application/bin/
Application/obj/

# --- IDE / editors ---
.vs/
.vscode/
.idea/
*.swp
*~

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store

